# ─────────────────────────────────────────────────────────────
#  ENOX – Umgebungsvariablen
#  Kopiere diese Datei zu ".env.local" (lokal) bzw. trage die Werte
#  in den Vercel-Projekt-Einstellungen ein (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Öffentliche Basis-URL (für OG-Bilder & absolute Links / Linktree-Vorschau).
# In Produktion z. B. https://foerdercheck.enox.de
SITE_URL=

# ── Fördercheck: Lead-E-Mail (Resend – https://resend.com) ──
# 1. Account bei resend.com anlegen (kostenloser Start verfügbar)
# 2. API-Key erstellen → hier eintragen
# 3. Eigene Domain bei Resend verifizieren (für seriösen Absender)
RESEND_API_KEY=
# Empfänger der Lead-Benachrichtigungen (Enes). Mehrere mit Komma getrennt.
LEAD_EMAIL_TO=enes@example.com
# Verifizierter Absender bei Resend, z. B. foerdercheck@enox.de
LEAD_EMAIL_FROM=foerdercheck@example.com

# ── Termin-Button auf dem Erfolgs-Screen (optional) ──
# Calendly / Cal.com o. ä. Bleibt leer → Button verlinkt auf /{sprache}/contact
BOOKING_URL=

# ── Optionaler Webhook an CRM / Zapier / Make (optional) ──
LEAD_WEBHOOK_URL=
