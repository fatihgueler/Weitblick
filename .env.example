# ─────────────────────────────────────────────────────────────
#  Weitblick Energieberatung – Umgebungsvariablen
#  Kopiere diese Datei zu ".env.local" (lokal) bzw. trage die Werte
#  in den Vercel-Projekt-Einstellungen ein (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Öffentliche Basis-URL (für OG-Bilder & absolute Links).
SITE_URL=https://weitblick-energieberatung.de

# ── Fördercheck & Kontakt: Lead-E-Mail (Resend – https://resend.com) ──
# 1. Account bei resend.com anlegen (kostenloser Start verfügbar)
# 2. API-Key erstellen → hier eintragen
# 3. Domain weitblick-energieberatung.de bei Resend verifizieren (SPF/DKIM)
RESEND_API_KEY=
# Empfänger der Lead-Benachrichtigungen. Mehrere mit Komma getrennt.
LEAD_EMAIL_TO=info@weitblick-energieberatung.de
# Verifizierter Absender bei Resend
LEAD_EMAIL_FROM=Weitblick Fördercheck <noreply@weitblick-energieberatung.de>

# ── Termin-Button auf dem Erfolgs-Screen (optional) ──
# Calendly / Cal.com o. ä. Bleibt leer → Button verlinkt auf /{sprache}/contact
BOOKING_URL=

# ── Optionaler Webhook an CRM / Zapier / Make (optional) ──
LEAD_WEBHOOK_URL=
