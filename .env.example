# ─────────────────────────────────────────────────────────────
#  Weitblick Energieberatung – Umgebungsvariablen
#  Kopiere diese Datei zu ".env.local" (lokal) bzw. trage die Werte
#  in den Vercel-Projekt-Einstellungen ein (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Öffentliche Basis-URL (für OG-Bilder & absolute Links).
SITE_URL=https://weitblick-energieberatung.de

# ── Fördercheck & Kontakt: Lead-E-Mail (Resend – https://resend.com) ──
# Domain weitblick-energieberatung.de ist bei Resend bereits verifiziert
# (SPF/DKIM/DMARC aktiv). Absender (info@) und Empfänger (kontakt@) sind fest
# in lib/email.ts hinterlegt und NICHT über ENV konfigurierbar.
# 1. Account bei resend.com öffnen
# 2. API-Key erstellen → hier eintragen
RESEND_API_KEY=

# ── Termin-Button auf dem Erfolgs-Screen (optional) ──
# Calendly / Cal.com o. ä. Bleibt leer → Button verlinkt auf /{sprache}/contact
BOOKING_URL=

# ── Optionaler Webhook an CRM / Zapier / Make (optional) ──
LEAD_WEBHOOK_URL=

# ── Lead-Tracking: Datenbank (Vercel Postgres / Neon) ──
# Wird automatisch gesetzt, sobald in Vercel eine Postgres-Datenbank mit dem
# Projekt verbunden ist (Storage → Postgres → Connect Project). Für die lokale
# Entwicklung die Werte aus dem Vercel-Dashboard (Storage → .env.local Tab) übernehmen.
POSTGRES_URL=

# ── Wochen-Digest: Vercel Cron Job ──
# Schützt /api/cron/weekly-digest vor externen Aufrufen. In Vercel unter
# Settings → Environment Variables setzen; Vercel Cron sendet den Wert dann
# automatisch als "Authorization: Bearer <CRON_SECRET>" Header mit.
CRON_SECRET=

# ── Admin-Bereich: Lead-PDF-Export (/admin/leads) ──
# Passwort für den HTTP-Basic-Auth-Schutz von /admin/* und /api/admin/*.
ADMIN_PASSWORD=
